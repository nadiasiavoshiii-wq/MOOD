<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MOOD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MOOD.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mood-loader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mood-background.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mood-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mood-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mood-happy.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="text-align:center;">
        MOOD site
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- ===== اسکریپت‌های MŌOD ===== -->
    <script>
        (function () {
            'use strict';

            const loader = document.getElementById('mood-loader');
            const startBtn = document.getElementById('startMood');
            const introStep = document.getElementById('introStep');
            const optionsStep = document.getElementById('optionsStep');
            const moodCard = document.getElementById('moodCard');
            const feelingBtns = document.querySelectorAll('.feeling-button');

            const urlParams = new URLSearchParams(window.location.search);
            const skipLoading = urlParams.get('skipLoading');

            // ===== نمایش مستقیم کادرها (بدون انیمیشن) =====
            function showCardsDirectly() {
                document.querySelectorAll('.mood-card').forEach(c => c.classList.add('show'));
            }

            // ===== رفتن به مرحله‌ی دوم (فوری و بدون فلاش) =====
            function goToStep2Directly() {
                // ===== introStep رو کامل مخفی کن =====
                if (introStep) {
                    introStep.style.display = 'none';
                    introStep.classList.add('hide');
                }
                if (moodCard) moodCard.style.minHeight = '500px';
                if (optionsStep) {
                    optionsStep.style.display = 'block';
                    optionsStep.classList.add('show');
                }
                showCardsDirectly();
            }

            // ===== رفتن به مرحله‌ی دوم (با انیمیشن برای دکمه "بزن بریم") =====
            function goToStep2WithAnimation() {
                if (introStep) introStep.classList.add('hide');
                if (moodCard) moodCard.style.minHeight = '500px';

                setTimeout(function () {
                    if (optionsStep) optionsStep.classList.add('show');
                    const cards = document.querySelectorAll('.mood-card');
                    cards.forEach((card, index) => {
                        setTimeout(() => {
                            card.classList.add('show');
                        }, 150 + (index * 80));
                    });
                }, 350);
            }

            // ===== لودینگ =====
            function hideLoader() {
                if (!loader) return;
                loader.classList.add('mood-loader-hide');
                loader.style.opacity = '0';
                loader.style.visibility = 'hidden';
                loader.style.pointerEvents = 'none';

                setTimeout(() => {
                    loader.style.display = 'none';
                    if (skipLoading !== 'true') {
                        const cards = document.querySelectorAll('.mood-card');
                        cards.forEach((card, index) => {
                            setTimeout(() => {
                                card.classList.add('show');
                            }, 150 + (index * 80));
                        });
                    }
                }, 900);
            }

            function initLoader() {
                if (skipLoading === 'true') {
                    console.log('⏭️ skipLoading فعال است، بدون انیمیشن و بدون فلاش!');
                    if (loader) loader.style.display = 'none';
                    // ===== نمایش فوری مرحله‌ی دوم بدون هیچ فلاشی =====
                    goToStep2Directly();
                    return;
                }

                if (document.readyState === 'complete') {
                    setTimeout(hideLoader, 2400);
                } else {
                    window.addEventListener('load', function () {
                        setTimeout(hideLoader, 2400);
                    });
                }
            }

            initLoader();

            // ===== دکمه "بزن بریم" (با انیمیشن) =====
            if (startBtn) {
                startBtn.addEventListener('click', function () {
                    console.log('✅ دکمه "بزن بریم" کلیک شد!');
                    goToStep2WithAnimation();
                });
            }

            // ===== کلیک روی احساسات =====
            feelingBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    console.log(`🎯 حس انتخاب شد: ${this.dataset.mood}`);
                });
            });

            console.log('✅ MŌOD: همه چیز آماده است!');
        })();
    </script>
</body>
</html>