@{
    ViewData["Title"] = "ورود | MŌOD";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(145deg, #ec4899 0%, #f472b6 35%, #fb923c 65%, #fbbf24 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
            margin: 0;
        }

        .login-card {
            max-width: 420px;
            width: 100%;
            padding: 48px 36px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(24px);
            box-shadow: 0 30px 100px rgba(0, 0, 0, 0.3);
            text-align: center;
            color: #fff;
        }

        .login-logo {
            font-size: 48px;
            font-weight: 900;
            color: #ffffff;
            margin-bottom: 8px;
            text-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
        }

        .login-sub {
            color: rgba(255, 255, 255, 0.4);
            font-size: 14px;
            margin-bottom: 32px;
        }

        .login-input-group {
            text-align: right;
            margin-bottom: 20px;
        }

            .login-input-group label {
                display: block;
                font-size: 13px;
                font-weight: 600;
                color: rgba(255, 255, 255, 0.6);
                margin-bottom: 6px;
            }

            .login-input-group input {
                width: 100%;
                padding: 14px 16px;
                border-radius: 16px;
                border: 1px solid rgba(255, 255, 255, 0.06);
                background: rgba(255, 255, 255, 0.04);
                color: #fff;
                font-size: 15px;
                transition: all 0.3s ease;
                outline: none;
            }

                .login-input-group input::placeholder {
                    color: rgba(255, 255, 255, 0.2);
                }

                .login-input-group input:focus {
                    border-color: rgba(255, 255, 255, 0.15);
                    background: rgba(255, 255, 255, 0.06);
                }

        .login-btn {
            width: 100%;
            padding: 14px;
            border-radius: 50px;
            border: none;
            background: linear-gradient(135deg, #db2777, #ec4899);
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 8px;
            box-shadow: 0 4px 20px rgba(236, 72, 153, 0.3);
        }

            .login-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 30px rgba(236, 72, 153, 0.4);
                background: linear-gradient(135deg, #be185d, #ec4899);
            }

        .login-footer {
            margin-top: 24px;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.3);
        }

            .login-footer a {
                color: rgba(255, 255, 255, 0.6);
                text-decoration: none;
                transition: color 0.3s ease;
            }

                .login-footer a:hover {
                    color: #fff;
                }

        .login-back {
            display: inline-block;
            margin-top: 20px;
            color: rgba(255, 255, 255, 0.3);
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s ease;
        }

            .login-back:hover {
                color: rgba(255, 255, 255, 0.6);
            }
    </style>
</head>

<body>
    <div class="login-card">
        <div class="login-logo">MŌOD</div>
        <div class="login-sub">به خونه‌ی حس‌هات خوش اومدی</div>

        <form method="post" action="/Account/Login">
            <div class="login-input-group">
                <label>ایمیل یا نام کاربری</label>
                <input type="text" placeholder="example@email.com" />
            </div>

            <div class="login-input-group">
                <label>رمز عبور</label>
                <input type="password" placeholder="••••••••" />
            </div>

            <button type="submit" class="login-btn" onclick="window.location.href='/Happy'">ورود</button>
        </form>

        <div class="login-footer">
            <a href="#">رمز عبور رو فراموش کردی؟</a>
            &nbsp;·&nbsp;
            <a href="#">ثبت‌نام</a>
        </div>

    </div>

    <script>
        document.querySelector('.login-btn').addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = '/Happy';
        });
    </script>
</body>
</html>