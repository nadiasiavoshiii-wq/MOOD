@{
    ViewData["Title"] = "نفس عمیق | MŌOD";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(145deg, #7dd3fc 0%, #38bdf8 35%, #0ea5e9 65%, #0c0a2a 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-y: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

            body::-webkit-scrollbar {
                display: none;
            }

        .breathing-card {
            max-width: 520px;
            width: 100%;
            padding: 40px 30px 50px;
            border-radius: 32px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(18px);
            box-shadow: 0 12px 45px rgba(0, 0, 0, 0.25);
            text-align: center;
            color: #fff;
            min-height: 520px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

            .breathing-card h1 {
                font-size: 32px;
                font-weight: 800;
                margin-bottom: 8px;
                background: linear-gradient(135deg, #ffffff, #bae6fd);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                text-shadow: 0 2px 20px rgba(56, 189, 248, 0.2);
            }

            .breathing-card p {
                font-size: 16px;
                color: rgba(255, 255, 255, 0.6);
                margin-bottom: 30px;
                font-weight: 500;
            }

        .breathing-circle {
            width: 180px;
            height: 180px;
            margin: 10px auto 20px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #7dd3fc, #0ea5e9);
            box-shadow: 0 0 50px rgba(56, 189, 248, 0.8), 0 0 100px rgba(56, 189, 248, 0.3);
            transition: all 4s ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            text-shadow: 0 2px 15px rgba(0, 0, 0, 0.15);
            transform-origin: center;
            flex-shrink: 0;
        }

            .breathing-circle.inhale {
                transform: scale(1.3);
                background: radial-gradient(circle at 30% 30%, #bae6fd, #38bdf8);
                box-shadow: 0 0 80px rgba(56, 189, 248, 1), 0 0 160px rgba(56, 189, 248, 0.5), 0 0 240px rgba(56, 189, 248, 0.2);
            }

            .breathing-circle.exhale {
                transform: scale(0.8);
                background: radial-gradient(circle at 30% 30%, #7dd3fc, #0ea5e9);
                box-shadow: 0 0 30px rgba(56, 189, 248, 0.3), 0 0 60px rgba(56, 189, 248, 0.1);
            }

        .breathing-btn {
            padding: 14px 40px;
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(8px);
            margin: 6px;
        }

            .breathing-btn:hover {
                background: rgba(255, 255, 255, 0.18);
                border-color: rgba(255, 255, 255, 0.25);
                transform: translateY(-3px);
            }

            .breathing-btn:disabled {
                opacity: 0.3;
                cursor: not-allowed;
                transform: none;
            }

        .breathing-btn-primary {
            background: linear-gradient(135deg, #38bdf8, #0ea5e9);
            border-color: #38bdf8;
            color: #fff;
            box-shadow: 0 4px 25px rgba(56, 189, 248, 0.2);
        }

            .breathing-btn-primary:hover {
                background: linear-gradient(135deg, #7dd3fc, #38bdf8);
                box-shadow: 0 8px 40px rgba(56, 189, 248, 0.3);
            }

        .breathing-timer {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.5);
            margin-top: 18px;
            font-weight: 500;
        }

        .breathing-status {
            font-size: 22px;
            font-weight: 700;
            color: #bae6fd;
            margin-top: 10px;
            min-height: 35px;
            text-shadow: 0 2px 20px rgba(56, 189, 248, 0.1);
        }

        /* ===== دکمه برگشت ===== */
        .back-link {
            display: inline-block;
            margin-top: 28px;
            padding: 12px 28px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.06);
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: all 0.3s ease;
            backdrop-filter: blur(8px);
            cursor: pointer;
        }

            .back-link:hover {
                background: rgba(255, 255, 255, 0.15);
                color: #fff;
                transform: translateY(-3px);
            }
    </style>
</head>

<body>

    <div class="breathing-card">
        <h1>🌬️ نفس عمیق</h1>
        <p>۵ دور نفس عمیق بکش و آرامش رو حس کن</p>

        <div class="breathing-circle" id="breathCircle">
            <span id="breathText">آماده‌ای؟</span>
        </div>

        <div class="breathing-status" id="breathStatus"></div>

        <div>
            <button class="breathing-btn breathing-btn-primary" id="startBtn">شروع</button>
            <button class="breathing-btn" id="resetBtn" disabled>ریست</button>
        </div>

        <div class="breathing-timer" id="breathTimer">دور ۰ از ۵</div>

        <a href="/Calm" class="back-link">← برگشت به آرومم</a>
    </div>

    <script>
        const circle = document.getElementById('breathCircle');
        const breathText = document.getElementById('breathText');
        const breathStatus = document.getElementById('breathStatus');
        const breathTimer = document.getElementById('breathTimer');
        const startBtn = document.getElementById('startBtn');
        const resetBtn = document.getElementById('resetBtn');

        let isRunning = false;
        let cycleCount = 0;
        const totalCycles = 5;
        let phase = 'idle';
        let timeoutId = null;

        function updateUI(text, status, timerText) {
            breathText.textContent = text;
            breathStatus.textContent = status || '';
            if (timerText) breathTimer.textContent = timerText;
        }

        function resetAll() {
            if (timeoutId) {
                clearTimeout(timeoutId);
                timeoutId = null;
            }
            isRunning = false;
            cycleCount = 0;
            phase = 'idle';
            circle.className = 'breathing-circle';
            updateUI('آماده‌ای؟', '', 'دور ۰ از ۵');
            startBtn.disabled = false;
            resetBtn.disabled = true;
        }

        function startBreathing() {
            if (isRunning) return;
            resetAll();
            isRunning = true;
            startBtn.disabled = true;
            resetBtn.disabled = false;
            cycleCount = 0;
            doCycle();
        }

        function doCycle() {
            if (cycleCount >= totalCycles) {
                updateUI('✅ تموم شد!', 'آفرین! آرامش رو حس کن 🌊', 'دور ' + totalCycles + ' از ' + totalCycles);
                isRunning = false;
                startBtn.disabled = false;
                resetBtn.disabled = true;
                circle.className = 'breathing-circle';
                return;
            }

            const currentCycle = cycleCount + 1;
            breathTimer.textContent = 'دور ' + currentCycle + ' از ' + totalCycles;

            phase = 'inhale';
            circle.className = 'breathing-circle inhale';
            updateUI('🌬️ دم...', 'نفس عمیق بکش', 'دور ' + currentCycle + ' از ' + totalCycles);

            timeoutId = setTimeout(() => {
                phase = 'hold';
                circle.className = 'breathing-circle';
                updateUI('🌀 نگه دار...', 'نفس رو نگه دار', 'دور ' + currentCycle + ' از ' + totalCycles);

                timeoutId = setTimeout(() => {
                    phase = 'exhale';
                    circle.className = 'breathing-circle exhale';
                    updateUI('💨 بازدم...', 'آروم رها کن', 'دور ' + currentCycle + ' از ' + totalCycles);

                    timeoutId = setTimeout(() => {
                        phase = 'idle';
                        circle.className = 'breathing-circle';
                        updateUI('⏸️ مکث...', '', 'دور ' + currentCycle + ' از ' + totalCycles);

                        timeoutId = setTimeout(() => {
                            cycleCount++;
                            doCycle();
                        }, 2000);

                    }, 4000);

                }, 2000);

            }, 4000);
        }

        startBtn.addEventListener('click', startBreathing);
        resetBtn.addEventListener('click', resetAll);

        resetAll();
    </script>

</body>
</html>